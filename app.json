{
  "expo": {
    "name": "Spotei",
    "slug": "spotei-app",
    "version": "1.0.0",
    "scheme": "spotei",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spotei.app"
    },
    "android": {
      "package": "com.spotei.app",
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "server"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita selecionar a foto do carro para seu spot.",
          "cameraPermission": "Permita fotografar carros para publicar seus spots.",
          "microphonePermission": false
        }
      ],
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita usar sua localização para preencher a cidade do spot. Só a cidade será salva; suas coordenadas não serão armazenadas."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Permita usar o Face ID para entrar no Spotei."
        }
      ],
      "expo-status-bar",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
