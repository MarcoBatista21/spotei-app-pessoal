{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_MODE": "demo",
        "EXPO_PUBLIC_IA_MODE": "simulada"
      }
    },
    "preview-real": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_MODE": "production",
        "EXPO_PUBLIC_IA_MODE": "gemini"
      }
    }
  }
}
